# Binaries and build output
# Root-anchored on purpose: a bare "ledgerline" pattern also matches
# the cmd/ledgerline/ source directory and silently un-commits it.
/ledgerline
*.exe
/dist/

# Go
*.test
*.out

# Editor
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Local bundles from replay export
*.jsonl
